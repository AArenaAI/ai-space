# =====================
# AI Pool Backend Config
# =====================

# ---- API Keys ----
# OpenAI 官方模型专用：直连 https://api.openai.com，不读取 OPENAI_BASE_URL
OPENAI_OFFICIAL_API_KEY=sk-proj-...
# OpenAI Webhook signing secret（Dashboard 里创建 endpoint 后获得，形如 whsec_...）
OPENAI_WEBHOOK_SECRET=whsec_...
# OpenAI 兼容中转配置：保留给其他 Provider / Embedding / Vision / PPT 等回退链复用
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
MOONSHOT_API_KEY=sk-...
BRAVE_SEARCH_KEY=...
TAVILY_SEARCH_KEY=...

# ---- Base URLs (optional) ----
# 注意：OpenAI 官方对话模型不会读取这个值；这里作为兼容中转地址供其他回退链复用
OPENAI_BASE_URL=http://cli-proxy-api:8317
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
MOONSHOT_BASE_URL=

# ---- Image Generation ----
# AI 画图/二次编辑强制走 OpenAI 官方 API；留空时复用 OPENAI_OFFICIAL_API_KEY，绝不读取 OPENAI_BASE_URL 中转
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=gpt-image-2

# ---- Model Pricing (per 1K tokens, USD) ----
# e.g. OPENAI_INPUT_PRICE=0.01  OPENAI_OUTPUT_PRICE=0.04

# ---- Max Output Tokens ----
# OpenAI Responses API base limit
OPENAI_MAX_OUTPUT_TOKENS=8192
# OpenAI with search enabled
OPENAI_MAX_OUTPUT_TOKENS_SEARCH=6400
# OpenAI reasoning/deep thinking limit; empty/unset inherits OPENAI_MAX_OUTPUT_TOKENS
OPENAI_MAX_OUTPUT_TOKENS_DEEP=8192
# OpenAI reasoning + search limit; empty/unset inherits OPENAI_MAX_OUTPUT_TOKENS_SEARCH
OPENAI_MAX_OUTPUT_TOKENS_DEEP_SEARCH=6400
# GPT-5.5 Pro 独立输出与本地保护：并发默认 1；TPM=0 表示不做本地软限制
OPENAI_GPT55_PRO_MAX_OUTPUT_TOKENS=8192
OPENAI_GPT55_PRO_MAX_OUTPUT_TOKENS_SEARCH=6400
OPENAI_GPT55_PRO_MAX_OUTPUT_TOKENS_DEEP=8192
OPENAI_GPT55_PRO_MAX_OUTPUT_TOKENS_DEEP_SEARCH=6400
OPENAI_GPT55_PRO_MAX_CONCURRENCY=1
OPENAI_GPT55_PRO_TPM_SOFT_LIMIT=0
# DeepSeek chat completion max_tokens
DEEPSEEK_MAX_TOKENS=8192
# Anthropic Claude max_tokens
ANTHROPIC_MAX_TOKENS=4096

# ---- Other ----
FILE_STORAGE_DIR=./uploads
GUEST_DAILY_CHAT_LIMIT=10
JWT_SECRET=change-me-to-a-random-string
GEMINI_API_KEY=AIza...
