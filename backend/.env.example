# =====================
# AI Pool Backend Config
# =====================

# ---- API Keys ----
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
MOONSHOT_API_KEY=sk-...
BRAVE_SEARCH_KEY=...
TAVILY_SEARCH_KEY=...

# ---- Base URLs (optional, defaults to official) ----
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
MOONSHOT_BASE_URL=

# ---- Model Pricing (per 1K tokens, USD) ----
# e.g. OPENAI_INPUT_PRICE=0.01  OPENAI_OUTPUT_PRICE=0.04

# ---- Max Output Tokens ----
# OpenAI Responses API base limit
OPENAI_MAX_OUTPUT_TOKENS=8192
# OpenAI with search enabled (lower to prevent streaming timeout)
OPENAI_MAX_OUTPUT_TOKENS_SEARCH=6400
# DeepSeek chat completion max_tokens
DEEPSEEK_MAX_TOKENS=8192
# Anthropic Claude max_tokens
ANTHROPIC_MAX_TOKENS=4096

# ---- Other ----
FILE_STORAGE_DIR=./uploads
GUEST_DAILY_CHAT_LIMIT=10
JWT_SECRET=change-me-to-a-random-string
